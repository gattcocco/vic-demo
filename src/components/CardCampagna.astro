---
/**
 * Card di una campagna in evidenza (spec §4.2): immagine di supporto, titolo dentro un vero <a>,
 * una riga di descrizione. Tutta la card è cliccabile senza onclick: lo pseudo-elemento ::after
 * del link del titolo copre l'intera card (position: relative sulla card).
 * I link esterni (sito attuale) hanno target="_blank" rel="noopener"; quelli interni passano da href().
 * Le immagini sono segnaposto dichiarati (vedi scripts/segnaposto.sh): da sostituire con fotografie del VIC.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { href, esterno } from '../lib/url';

interface Props {
  titolo: string;
  descrizione: string;
  immagine: ImageMetadata;
  alt: string;
  url: string;
  prioritaria?: boolean;
}
const { titolo, descrizione, immagine, alt, url, prioritaria = false } = Astro.props;
const isEsterno = esterno(url);
---

<article class="card">
  <Picture
    src={immagine}
    alt={alt}
    widths={[400, 800]}
    sizes="(min-width: 768px) 22rem, 85vw"
    width={600}
    height={400}
    formats={['avif']}
    fallbackFormat="webp"
    loading={prioritaria ? 'eager' : 'lazy'}
    decoding="async"
  />
  <div class="card__testo">
    <h3 class="card__titolo">
      <a href={href(url)} {...isEsterno ? { target: '_blank', rel: 'noopener' } : {}}>
        {titolo}{isEsterno && <span class="sr-only"> (sul sito attuale, si apre in una nuova finestra)</span>}
      </a>
    </h3>
    <p class="card__descrizione">{descrizione}</p>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--superficie);
    border: var(--spessore-bordo) solid var(--bordo);
  }
  .card:hover {
    border-color: var(--superficie-scura);
  }
  .card :global(picture),
  .card :global(img) {
    width: 100%;
  }
  .card :global(img) {
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }
  .card__testo {
    padding: var(--spazio-3);
    display: flex;
    flex-direction: column;
    gap: var(--spazio-1);
  }
  .card__titolo a {
    color: var(--testo);
  }
  .card__titolo a:hover {
    color: var(--azione);
  }
  /* Il link del titolo si estende su tutta la card: nessun onclick sul contenitore. */
  .card__titolo a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__descrizione {
    color: var(--testo-debole);
  }
  /* Con :has il contorno di focus abbraccia l'intera card; altrimenti resta sul link. */
  @supports selector(:has(a)) {
    .card:has(.card__titolo a:focus-visible) {
      outline: var(--focus);
      outline-offset: 3px;
    }
    .card__titolo a:focus-visible {
      outline: none;
    }
  }
</style>
